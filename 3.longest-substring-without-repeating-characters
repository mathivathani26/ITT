class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        vector<int> last_idx(128, -1);
        int max_len = 0;
        int start = 0;

        for (int i = 0; i < s.length(); i++) {
            char c = s[i];
            if (last_idx[c] >= start) {
                start = last_idx[c] + 1;
            }
            last_idx[c] = i;
            max_len = max(max_len, i - start + 1);
        }
        
        return max_len;
    }
};
