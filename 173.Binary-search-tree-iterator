typedef struct {
    struct TreeNode** stack;
    int top;                 
    int capacity;            
} BSTIterator;
void pushAllLeft(BSTIterator* obj, struct TreeNode* node) {
    while (node != NULL) {
        if (obj->top >= obj->capacity - 1) {
            obj->capacity *= 2;
            obj->stack = (struct TreeNode**)realloc(obj->stack, obj->capacity * sizeof(struct TreeNode*));
        }
        obj->stack[++(obj->top)] = node;
        node = node->left;
    }
}
BSTIterator* bSTIteratorCreate(struct TreeNode* root) {
    int initialCapacity = 100; 
    BSTIterator* obj = (BSTIterator*)malloc(sizeof(BSTIterator));
    obj->stack = (struct TreeNode**)malloc(initialCapacity * sizeof(struct TreeNode*));
    obj->top = -1;
    obj->capacity = initialCapacity;
    pushAllLeft(obj, root);
    return obj;
}
int bSTIteratorNext(BSTIterator* obj) {
    struct TreeNode* node = obj->stack[(obj->top)--];
    if (node->right != NULL) {
        pushAllLeft(obj, node->right);
    }  
    return node->val;
}
bool bSTIteratorHasNext(BSTIterator* obj) {
    return obj->top != -1;
}
void bSTIteratorFree(BSTIterator* obj) {
    free(obj->stack);
    free(obj);
}
