int* maxSubarray(int* nums, int numsSize, int selectLen) {
    int* result = (int*)malloc(selectLen * sizeof(int));
    int top = -1;
    int dropRemaining = numsSize - selectLen; 
    for (int i = 0; i < numsSize; i++) {
        while (top >= 0 && result[top] < nums[i] && dropRemaining > 0) {
            top--;
            dropRemaining--;
        }
        if (top < selectLen - 1) {
            result[++top] = nums[i];
        } else {
            dropRemaining--; 
        }
    }
    return result;
}
bool isGreater(int* nums1, int size1, int idx1, int* nums2, int size2, int idx2) {
    while (idx1 < size1 && idx2 < size2) {
        if (nums1[idx1] > nums2[idx2]) return true;
        if (nums1[idx1] < nums2[idx2]) return false;
        idx1++;
        idx2++;
    }
    return (size1 - idx1) > (size2 - idx2);
}
int* mergeSubarrays(int* max1, int size1, int* max2, int size2, int k) {
    int* merged = (int*)malloc(k * sizeof(int));
    int idx1 = 0, idx2 = 0, targetIdx = 0;
    while (targetIdx < k) {
        if (isGreater(max1, size1, idx1, max2, size2, idx2)) {
            merged[targetIdx++] = max1[idx1++];
        } else {
            merged[targetIdx++] = max2[idx2++];
        }
    }
    return merged;
}
int* maxNumber(int* nums1, int nums1Size, int* nums2, int nums2Size, int k, int* returnSize) {
    *returnSize = k;
    int* bestResult = (int*)calloc(k, sizeof(int));
    for (int i = 0; i <= k; i++) {
        int j = k - i;
        if (i > nums1Size || j > nums2Size) continue;
        int* sub1 = maxSubarray(nums1, nums1Size, i);
        int* sub2 = maxSubarray(nums2, nums2Size, j);
        int* currentCandidate = mergeSubarrays(sub1, i, sub2, j, k);
        if (isGreater(currentCandidate, k, 0, bestResult, k, 0)) {
            memcpy(bestResult, currentCandidate, k * sizeof(int));
        }
        free(sub1);
        free(sub2);
        free(currentCandidate);
    }
    return bestResult;
}
