#include <stdio.h>
#include <string.h>
#include <stdlib.h>
char* simplifyPath(char* path) {
    int n = strlen(path);
    char* canonicalPath = (char*)malloc((n + 1) * sizeof(char));
    char** stack = (char**)malloc((n + 1) * sizeof(char*));
    int top = 0; 
    char* token = strtok(path, "/");
    while (token != NULL) {
        if (strcmp(token, ".") == 0 || strcmp(token, "") == 0) {
        } else if (strcmp(token, "..") == 0) {
            if (top > 0) {
                top--;
            }
        } else {
            stack[top++] = token;
        }
        token = strtok(NULL, "/");
    }
    if (top == 0) {
        strcpy(canonicalPath, "/");
    } else {
        canonicalPath[0] = '\0'; 
        for (int i = 0; i < top; i++) {
            strcat(canonicalPath, "/");
            strcat(canonicalPath, stack[i]);
        }
    }
    free(stack);
    return canonicalPath;
}
