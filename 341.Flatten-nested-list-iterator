#include <stdbool.h>
#include <stdlib.h>
struct NestedIterator {
    int* data;      
    int cursor;     
    int size;      
};
void flatten(struct NestedInteger** list, int size, int** data, int* count, int* capacity) {
    for (int i = 0; i < size; i++) {
        if (NestedIntegerIsInteger(list[i])) {
            if (*count >= *capacity) {
                *capacity *= 2;
                *data = (int*)realloc(*data, (*capacity) * sizeof(int));
            }
            (*data)[(*count)++] = NestedIntegerGetInteger(list[i]);
        } else {
            flatten(NestedIntegerGetList(list[i]), NestedIntegerGetListSize(list[i]), data, count, capacity);
        }
    }
}
struct NestedIterator *nestedIteratorCreate(struct NestedInteger** nestedList, int nestedListSize) {
    struct NestedIterator *iter = (struct NestedIterator*)malloc(sizeof(struct NestedIterator));
    
    int capacity = 100;
    iter->data = (int*)malloc(capacity * sizeof(int));
    iter->cursor = 0;
    iter->size = 0;
    
    flatten(nestedList, nestedListSize, &(iter->data), &(iter->size), &capacity);
    
    return iter;
}

bool nestedIteratorHasNext(struct NestedIterator *iter) {
    return iter->cursor < iter->size;
}

int nestedIteratorNext(struct NestedIterator *iter) {
    return iter->data[(iter->cursor)++];
}

void nestedIteratorFree(struct NestedIterator *iter) {
    if (iter) {
        free(iter->data);
        free(iter);
    }
}


struct NestedIterator *nestedIterCreate(struct NestedInteger** nestedList, int nestedListSize) {
    return nestedIteratorCreate(nestedList, nestedListSize);
}

bool nestedIterHasNext(struct NestedIterator *iter) {
    return nestedIteratorHasNext(iter);
}

int nestedIterNext(struct NestedIterator *iter) {
    return nestedIteratorNext(iter);
}

void nestedIterFree(struct NestedIterator *iter) {
    nestedIteratorFree(iter);
}
