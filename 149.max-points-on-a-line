class Solution {
public:
    int maxPoints(vector<vector<int>>& points) {
        int n = points.size();
        if (n <= 2) return n;
        int maxPointsOnLine = 2;
        for (int i = 0; i < n; ++i) {
            unordered_map<string, int> slopeCount; 
            for (int j = i + 1; j < n; ++j) {
                int dx = points[j][0] - points[i][0];
                int dy = points[j][1] - points[i][1];
                int gcdVal = std::gcd(dx, dy);
                dx /= gcdVal;
                dy /= gcdVal;
                if (dx < 0) {
                    dx = -dx;
                    dy = -dy;
                } else if (dx == 0) {
                    dy = 1; 
                }
                string slopeKey = to_string(dy) + "/" + to_string(dx);
                slopeCount[slopeKey]++;
                maxPointsOnLine = max(maxPointsOnLine, slopeCount[slopeKey] + 1);
            }
        }  
        return maxPointsOnLine;
    }
};
