#include <stdio.h>
#include <stdlib.h>
typedef struct {
    int *data;
    int size;
    int capacity;
    int is_max_heap; 
} Heap;
Heap* createHeap(int cap, int is_max) {
    Heap* h = (Heap*)malloc(sizeof(Heap));
    h->data = (int*)malloc(cap * sizeof(int));
    h->size = 0;
    h->capacity = cap;
    h->is_max_heap = is_max;
    return h;
}
int compare(Heap* h, int a, int b) {
    if (h->is_max_heap) {
        return a > b; 
    }
    return a < b;     
}
void swap(int *x, int *y) {
    int temp = *x;
    *x = *y;
    *y = temp;
}
void push(Heap* h, int val) {
    if (h->size == h->capacity) {
        h->capacity *= 2;
        h->data = (int*)realloc(h->data, h->capacity * sizeof(int));
    }
    h->data[h->size] = val;
    int curr = h->size;
    h->size++;
    while (curr > 0) {
        int p = (curr - 1) / 2;
        if (compare(h, h->data[curr], h->data[p])) {
            swap(&h->data[curr], &h->data[p]);
            curr = p;
        } else {
            break;
        }
    }
}
int pop(Heap* h) {
    if (h->size == 0) return 0;
    int top_val = h->data[0];
    h->size--;
    h->data[0] = h->data[h->size];
    int curr = 0;
    while (2 * curr + 1 < h->size) {
        int left = 2 * curr + 1;
        int right = 2 * curr + 2;
        int target = left;
        if (right < h->size && compare(h, h->data[right], h->data[left])) {
            target = right;
        }
        if (compare(h, h->data[target], h->data[curr])) {
            swap(&h->data[curr], &h->data[target]);
            curr = target;
        } else {
            break;
        }
    }
    return top_val;
}
int peek(Heap* h) {
    return h->data[0];
}
typedef struct {
    Heap* max_heap;
    Heap* min_heap;
} MedianFinder;
MedianFinder* medianFinderCreate() {
    MedianFinder* obj = (MedianFinder*)malloc(sizeof(MedianFinder));
    obj->max_heap = createHeap(1000, 1); 
    obj->min_heap = createHeap(1000, 0); 
    return obj;
}

void medianFinderAddNum(MedianFinder* obj, int num) {
    // Step 1: Add to Max-Heap if empty or smaller than max-heap's top
    if (obj->max_heap->size == 0 || num <= peek(obj->max_heap)) {
        push(obj->max_heap, num);
    } else {
        push(obj->min_heap, num);
    }
    
    // Step 2: Balance the heap sizes (Difference cannot be more than 1)
    if (obj->max_heap->size > obj->min_heap->size + 1) {
        push(obj->min_heap, pop(obj->max_heap));
    } else if (obj->min_heap->size > obj->max_heap->size) {
        push(obj->max_heap, pop(obj->min_heap));
    }
}

double medianFinderFindMedian(MedianFinder* obj) {
    // If odd number of total elements, max_heap holds the extra element
    if (obj->max_heap->size > obj->min_heap->size) {
        return (double)peek(obj->max_heap);
    }
    // If even number of elements, take average of both tops
    return (peek(obj->max_heap) + peek(obj->min_heap)) / 2.0;
}

void medianFinderFree(MedianFinder* obj) {
    free(obj->max_heap->data);
    free(obj->max_heap);
    free(obj->min_heap->data);
    free(obj->min_heap);
    free(obj);
}
