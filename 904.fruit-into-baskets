int totalFruit(int* fruits, int fruitsSize) {
    int left = 0;
    int maxFruits = 0;
    int f1[2] = {-1, 0};
    int f2[2] = {-1, 0};
    for (int right = 0; right < fruitsSize; right++) {
        int currentFruit = fruits[right];
        if (f1[0] == currentFruit) {
            f1[1]++;
        } else if (f2[0] == currentFruit) {
            f2[1]++;
        } 
        else if (f1[0] == -1) {
            f1[0] = currentFruit;
            f1[1] = 1;
        } else if (f2[0] == -1) {
            f2[0] = currentFruit;
            f2[1] = 1;
        } 
        else {
            while (f1[1] > 0 && f2[1] > 0) {
                int leftFruit = fruits[left];
                if (leftFruit == f1[0]) f1[1]--;
                if (leftFruit == f2[0]) f2[1]--;
                left++;
            }
            if (f1[1] == 0) {
                f1[0] = currentFruit;
                f1[1] = 1;
            } else {
                f2[0] = currentFruit;
                f2[1] = 1;
            }
        }
        int currentWindowSize = right - left + 1;
        if (currentWindowSize > maxFruits) {
            maxFruits = currentWindowSize;
        }
    }
    return maxFruits;
}
